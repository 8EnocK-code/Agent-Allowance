# Move this file to .github/workflows/ci.yml (needs a token with `workflow` scope, or add it via the GitHub web UI).
name: CI
on:
  push: { branches: [main] }
  pull_request:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: npm }
      - run: npm ci
      - run: npm test
      - run: npm run demo
      - name: Front end builds
        working-directory: frontend
        run: |
          npm ci
          npm run build
