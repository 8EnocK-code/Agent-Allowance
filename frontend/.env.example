# Copy to .env.local. Addresses come from ../deployments/botTestnet.json after deploy.
# Example: VITE_VAULT_ADDRESS=0x...  VITE_POT_ADDRESS=0x...
# You can also paste addresses directly in the UI (they persist in localStorage).
VITE_VAULT_ADDRESS=
VITE_POT_ADDRESS=
# BOT Chain testnet RPC (chain ID 968). Not published in the integration guide yet.
# Needed so wallets can auto-add the testnet. Switching works without it.
VITE_TESTNET_RPC_URL=
